{
  "name": "votar-explorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'infra/**' && node --test infra/*.test.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/schema.sql"
  },
  "dependencies": {
    "next": "16.4.6",
    "postgres": "^3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "solc": "0.8.26",
    "viem": "^2.38.6"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "typescript": "^7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}
