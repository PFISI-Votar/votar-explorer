# URL privada del gateway RPC publicada por Cloudflare Tunnel.
RPC_URL=https://rpc.example.org
CHAIN_ID=31337
NETWORK_NAME=VOTAR Simulacro

# Service Token de una aplicación Cloudflare Access de tipo Service Auth.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# PostgreSQL compatible (Vercel Postgres, Neon, Supabase, etc.).
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Token largo y aleatorio, usado solo por administradores para verificar contratos.
VERIFY_API_TOKEN=
